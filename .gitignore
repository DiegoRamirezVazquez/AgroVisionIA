# =============================================
# AgroVisionIA - .gitignore
# =============================================

# ----- Entornos virtuales -----
.venv/
venv/
env/
ENV/

# ----- IDEs y editores -----
.idea/
.vscode/
*.swp
*.swo
*~

# ----- Python bytecode -----
__pycache__/
*.py[cod]
*$py.class

# ----- Distribución / empaquetado -----
build/
dist/
*.egg-info/
*.egg

# ----- Variables de entorno -----
.env
.envrc

# ----- Testing -----
.pytest_cache/
.coverage
htmlcov/

# ----- Logs -----
*.log

# ----- Archivos temporales -----
tempCodeRunnerFile.py

# ----- Type checkers -----
.mypy_cache/
.ruff_cache/

# ----- OS files -----
Thumbs.db
.DS_Store
